# Flask
FLASK_ENV=production
FLASK_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Database
DATABASE_URL=postgresql://flatfinder:CHANGEME@localhost:5432/flatfinder

# Redis
REDIS_URL=redis://localhost:6379/0

# Public URL of the app (used for links in notifications etc.)
APP_BASE_URL=http://localhost

# Storage paths
DATA_DIR=/var/lib/flat-finder
IMAGE_DIR=/var/lib/flat-finder/images
SNAPSHOT_DIR=/var/lib/flat-finder/snapshots

# Import limits
MAX_IMPORT_DOWNLOAD_SIZE_MB=20
MAX_IMAGE_DOWNLOAD_SIZE_MB=10
IMPORT_HTTP_TIMEOUT=15

# Routing & Geocoding providers
ROUTING_PROVIDER=mock
GEOCODING_PROVIDER=nominatim
OPENROUTESERVICE_API_KEY=
OSRM_BASE_URL=
NOMINATIM_USER_AGENT=flat-finder/1.0 (admin@example.com)

# Auth / security
LOGIN_RATE_LIMIT=10 per minute
ALLOW_REGISTRATION=false

# Reverse-proxy hops to trust X-Forwarded-* headers from.
# 1 = single proxy (Nginx OR Cloudflare tunnel). 2 = both Nginx + tunnel.
PROXY_FIX_HOPS=1

# Logging
LOG_LEVEL=INFO

# Score display preference: personal | average | both
DEFAULT_SCORE_DISPLAY=both
